  "caseResultRules": {
    "PASS": "All common and conditional required evidence is present, every pinned hash and stable id is consistent, raw originals and external copies exist, no hidden retry, ports released, subprocess exit 0, usage is truthful (unknown is not forged to 0), and the L3 path did not substitute an L2 stub.",
    "FAIL": "A documented hard assertion was executed and did not hold, or required evidence exists but contradicts another field. A FAIL in any required case forces NO_GO.",
    "NOT_RUN": "The case was never executed on this attempt. NOT_RUN is never aggregated into PASS.",
    "BLOCKED_EXTERNAL": "An external dependency or a required human authorization is unavailable (for example an unauthorized or unreachable L3 MCP, or a withheld W04 recovery authorization). Never converted to NOT_RUN or PASS.",
    "UPSTREAM_UNSUPPORTED": "The frozen reference DeerFlow backend has no corresponding semantics for a specific assertion. Recorded only for the reference side; never counted as a Haifa PASS.",
    "NOT_APPLICABLE": "The case does not apply to the backend under test (for example the reference side of the Haifa-only V2-M6 stages)."
  },
  "aggregation": {
    "mutualExclusion": "Every case result is exactly one of the result vocabulary values; a case cannot be recorded as both a run and NOT_RUN, or both PASS and FAIL.",
    "reportingPrecedence": [
      "FAIL",
      "BLOCKED_EXTERNAL",
      "UPSTREAM_UNSUPPORTED",
      "NOT_RUN",
      "PASS"
    ],
    "stagePassRule": "A stage is PASS only if every required case for that stage is PASS on the Haifa backend. NOT_RUN, BLOCKED_EXTERNAL, UPSTREAM_UNSUPPORTED, NOT_APPLICABLE, V1 evidence, static contract checks, or a single component/work-package PASS never aggregate into a V2 stage PASS.",
    "stageResultVocabulary": [
      "PASS",
      "FAIL",
      "NOT_RUN",
      "BLOCKED_EXTERNAL"
    ],
    "goRule": "GO requires every V2-M1..V2-M6 stage PASS on the same main SHA, every required case PASS with raw originals and external copies present, zero hidden retries, and a signed human/客户 Pilot declaration for V2-M6. Any missing required evidence, inconsistent field, uncleaned port/process, wrong SHA or hash, mock/substitution, hidden retry, expired credential reference, or missing human declaration forces NO_GO.",
    "forbiddenEvidence": [
      "v1-evidence-as-v2",
      "component-pass-as-stage-pass",
      "static-contract-as-runtime",
      "fixture-json-as-mcp-call",
      "terminal-summary-as-raw-original",
      "reference-fallback-hidden"
    ]
  },
  "noGoConditions": [
    {
      "id": "missing-case",
      "rule": "The instance does not contain every one of the 48 oracle case ids."
    },
    {
      "id": "missing-required-evidence",
      "rule": "A PASS case omits a common or conditional required evidence field."
    },
    {
      "id": "field-inconsistency",
      "rule": "Two evidence fields contradict each other (for example a declared duration or status that does not match its raw original)."
    },
    {
      "id": "wrong-main-sha",
      "rule": "pins.mainSha differs from the expected main SHA, or cases across stages/kinds do not share one main SHA."
    },
    {
      "id": "wrong-sdk-sha",
      "rule": "The recorded Haifa SDK BOM/JAR SHA-256 or SDK commit does not match the published artifact actually consumed."
    },
    {
      "id": "wrong-fixture-hash",
      "rule": "A fixture SHA-256 does not match the frozen fixture or the actual bytes."
    },
    {
      "id": "wrong-config-hash",
      "rule": "A config SHA-256 does not match the frozen config or the actual bytes."
    },
    {
      "id": "forged-zero-usage",
      "rule": "Usage is recorded as 0 when it is actually unknown; unknown must be null/unknown, never a forged 0."
    },
    {
      "id": "id-mismatch",
      "rule": "Run/ToolCall/Interaction/Artifact stable ids disagree between the case record and the provenance original."
    },
    {
      "id": "missing-raw-evidence",
      "rule": "A referenced raw HTTP/SSE/WS/Tool original file is absent or its SHA-256 does not match."
    },
    {
      "id": "missing-external-copy",
      "rule": "The raw evidence was not copied to the external evidence directory, so a later clean would destroy it."
    },
    {
      "id": "l3-l2-stub",
      "rule": "An L3 case substitutes the deterministic L2 fixture/stub for a real authorized read-only MCP call."
    },
    {
      "id": "l3-undeclared-tool",
      "rule": "An L3 case uses a tool/fact that was not declared and authorized by the human decision."
    },
    {
      "id": "tools-call-trace",
      "rule": "A tools/call trace appears where only discovery (initialize/tools/list) is authorized, or the doctor probes tools/call."
    },
    {
      "id": "hidden-retry",
      "rule": "A retry or best-round selection occurred without recording the first failure, the retry count, and the retry cause."
    },
    {
      "id": "v1-evidence-as-v2",
      "rule": "A case is marked PASS using V1 (DEMO-V0) evidence instead of a fresh V2 run."
    },
    {
      "id": "not-run-as-pass",
      "rule": "A NOT_RUN case or stage is reported as PASS."
    },
    {
      "id": "upstream-unsupported-as-pass",
      "rule": "An UPSTREAM_UNSUPPORTED reference result is counted as a Haifa PASS."
    },
    {
      "id": "uncleaned",
      "rule": "A port or child process launched for the case was not released after the run."
    },
    {
      "id": "nonzero-subprocess-exit",
      "rule": "A required child process exited non-zero without being recorded."
    },
    {
      "id": "missing-human-declaration",
      "rule": "The V2-M6 human/客户 Pilot declaration is absent, unsigned, or not bound to the run."
    }
  ],
