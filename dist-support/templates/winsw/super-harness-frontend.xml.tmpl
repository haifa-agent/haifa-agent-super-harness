<?xml version="1.0" encoding="utf-8"?>
<!-- Rendered by scripts/install-service.py (WinSW); placeholders are substituted at install
     time and env entries are expanded from config/gateway.env.
     Do not commit a rendered copy: it contains HAIFA_SH_CONTINUATION_KEY. -->
<service>
  <id>${service_id}</id>
  <name>Haifa Super Harness Frontend</name>
  <description>Haifa Super Harness frozen DeerFlow frontend (loopback only). Managed by dist-support.</description>
  <executable>${node_bin}</executable>
  <arguments>"${prefix}\repo\frontend\node_modules\next\dist\bin\next" start --hostname 127.0.0.1 --port ${frontend_port}</arguments>
  <workingdirectory>${prefix}\repo\frontend</workingdirectory>
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec"/>
  <logmode>append</logmode>
  <logpath>${prefix}\logs</logpath>
${depend_xml}${service_account_xml}${env_entries}</service>
