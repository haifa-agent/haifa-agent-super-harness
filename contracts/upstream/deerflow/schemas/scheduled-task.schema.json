{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "thread_id",
    "context_mode",
    "assistant_id",
    "title",
    "prompt",
    "schedule_type",
    "schedule_spec",
    "timezone",
    "status",
    "next_run_at",
    "last_run_at",
    "last_run_id",
    "last_thread_id",
    "last_error",
    "run_count",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {"type": "string"},
    "thread_id": {"type": ["string", "null"]},
    "context_mode": {"enum": ["fresh_thread_per_run", "reuse_thread"]},
    "assistant_id": {"type": ["string", "null"]},
    "title": {"type": "string"},
    "prompt": {"type": "string"},
    "schedule_type": {"enum": ["once", "cron", "interval"]},
    "schedule_spec": {"type": "object"},
    "timezone": {"type": "string"},
    "status": {"enum": ["enabled", "paused", "running", "completed", "failed", "cancelled"]},
    "next_run_at": {"type": ["string", "null"]},
    "last_run_at": {"type": ["string", "null"]},
    "last_run_id": {"type": ["string", "null"]},
    "last_thread_id": {"type": ["string", "null"]},
    "last_error": {"type": ["string", "null"]},
    "run_count": {"type": "integer"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
