# Haifa Super Harness Gateway runtime environment.
# Rendered once by scripts/install-service.py install (idempotent): existing values are
# preserved on re-install, so operator-managed keys survive upgrades.
# Secrets (HAIFA_SH_CONTINUATION_KEY) live ONLY in this file; never log or commit it.
SUPER_HARNESS_PROFILE=local
SUPER_HARNESS_GATEWAY_KIND=haifa
SUPER_HARNESS_ENVIRONMENT=development
ENVIRONMENT=development
DEER_FLOW_ENV=development
DEER_FLOW_AUTH_DISABLED=1
SUPER_HARNESS_BIND_ADDRESS=127.0.0.1
SUPER_HARNESS_PORT=${gateway_port}
SUPER_HARNESS_DATA_DIR=${data_root}
SUPER_HARNESS_DATA_ROOT=${data_root}
DEER_FLOW_TRUSTED_ORIGINS=http://127.0.0.1:${frontend_port}
NEXT_PUBLIC_STATIC_WEBSITE_ONLY=false
# Official skills ship read-only under <prefix>/skills/public; the server scans that root.
HAIFA_SUPER_HARNESS_SKILLS_DIR=${skills_dir}
HAIFA_SUPER_HARNESS_CONTINUATION_KEY_REF=env://HAIFA_SH_CONTINUATION_KEY
# Execution provider: host-guarded (default) | docker-aio | disabled
HAIFA_SUPER_HARNESS_EXECUTION_PROVIDER=${execution_provider}
HAIFA_SUPER_HARNESS_DOCKER_IMAGE=${docker_image}
HAIFA_SUPER_HARNESS_DOCKER_SOCKET=${docker_socket}
HAIFA_SUPER_HARNESS_DOCKER_LIFECYCLE=${docker_lifecycle}
HAIFA_SUPER_HARNESS_DOCKER_IDLE_TIMEOUT_MS=${docker_idle_timeout_ms}
# Background scheduler daemon for scheduled tasks (cron / interval / once). Unset or 0 keeps it off.
HAIFA_SUPER_HARNESS_SCHEDULER_ENABLED=1
