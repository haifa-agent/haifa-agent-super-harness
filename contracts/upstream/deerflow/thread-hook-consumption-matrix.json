      "evidence_kind": "frozen_hook_source",
      "runtime_status": "NOT_RUN",
      "source_anchors": [
        "onFinish(state, run) {",
        "completedRunIdsRef.current.add(run.run_id);",
        "listeners.current.onFinish?.(state.values);"
      ]
