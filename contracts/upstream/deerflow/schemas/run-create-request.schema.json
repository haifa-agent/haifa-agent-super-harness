{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w00://deerflow/run-create-request",
  "type": "object",
  "properties": {
    "assistant_id": {"type": ["string", "null"]},
    "input": {"type": ["object", "null"]},
    "command": {"type": ["object", "null"]},
    "metadata": {"type": ["object", "null"]},
    "config": {"type": ["object", "null"]},
    "context": {"type": ["object", "null"]},
    "conversation_references": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "webhook": {"type": "null"},
    "checkpoint_id": {"type": ["string", "null"]},
    "checkpoint": {"type": ["object", "null"]},
    "interrupt_before": {
      "oneOf": [
        {"type": "array", "items": {"type": "string"}},
        {"const": "*"},
        {"type": "null"}
      ]
    },
    "interrupt_after": {
      "oneOf": [
        {"type": "array", "items": {"type": "string"}},
        {"const": "*"},
        {"type": "null"}
      ]
    },
    "stream_mode": {
      "oneOf": [
        {"enum": ["values", "messages-tuple", "updates", "debug", "tasks", "checkpoints", "custom"]},
        {
          "type": "array",
          "items": {"enum": ["values", "messages-tuple", "updates", "debug", "tasks", "checkpoints", "custom"]}
        },
        {"type": "null"}
      ]
    },
    "stream_subgraphs": {"type": "boolean", "default": false},
    "stream_resumable": {"enum": [false, null]},
    "on_disconnect": {"enum": ["cancel", "continue"], "default": "cancel"},
    "on_completion": {"type": "null"},
    "multitask_strategy": {"enum": ["reject", "rollback", "interrupt"], "default": "reject"},
    "after_seconds": {"type": "null"},
    "if_not_exists": {"const": "create", "default": "create"},
    "feedback_keys": {"type": "null"}
  },
  "additionalProperties": false
}
