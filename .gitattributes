# Maven Wrapper: keep the POSIX launcher as LF so ./mvnw stays executable from
# Git Bash/WSL even when core.autocrlf=true, and pin the Windows launcher to CRLF.
mvnw text eol=lf
mvnw.cmd text eol=crlf
.mvn/wrapper/maven-wrapper.properties text eol=lf
# Frozen Skill package hashes refer to exact upstream bytes on every checkout.
third-party/deerflow/skills/**/SKILL.md -text
# Complete frozen packages retain upstream byte hashes, including intentional whitespace.
third-party/deerflow/skills/e545c28ac301e6f9feae247c513d8ea8f83df294/** -text whitespace=-trailing-space
# The trusted Skill manifest hashes pinned DeerFlow license LF bytes. Pin every license file so a
# fresh worktree with core.autocrlf=true cannot materialize CRLF and fail the strict hash check.
third-party/deerflow/LICENSES/*.txt text eol=lf
# Byte-faithful frozen lead-agent prompt template: keep committed bytes untouched and treat its
# deliberate final trailing spaces as data, not a check failure.
resources/upstream/deerflow/prompts/*.txt -text whitespace=-trailing-space
resources/upstream/deerflow/prompts/*.sha256 text eol=lf
resources/upstream/deerflow/prompts/*.json text eol=lf
resources/upstream/deerflow/prompts/*.md text eol=lf
# Tool description and manifest ledger hashes use the same LF bytes on every checkout.
super-harness-server/src/main/resources/upstream/deerflow/tool-descriptions/* text eol=lf
# Frozen plan-mode prompt resources hash committed LF bytes on every checkout.
super-harness-server/src/main/resources/upstream/deerflow/prompts/* text eol=lf
# Frozen Skill scanner manifests hash committed LF bytes, including Python resources.
super-harness-server/src/main/resources/upstream/deerflow/w15/** text eol=lf
