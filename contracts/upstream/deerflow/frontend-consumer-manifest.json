      "registration_condition": "When static mode is off, auth-disabled mode is off, and an access_token cookie exists, Next SSR calls the internal gateway with cache=no-store and a bounded timeout.",
      "status": "SOURCE_VERIFIED",
      "runtime_status": "NOT_RUN",
      "evidence": [
