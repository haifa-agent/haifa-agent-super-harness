    {
      "id": "auth.setup-status.browser",
      "category": "auth",
      "consumer": "browser_fetch",
      "transport": "REST",
      "methods": ["GET"],
      "public_path": "/api/v1/auth/setup-status",
      "gateway_path": "/api/v1/auth/setup-status",
      "registration_condition": "Registered whenever the auth router is included; browser and SSR use it when setup state is needed.",
