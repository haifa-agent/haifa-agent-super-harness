    "thread_id": {"type": "string"},
    "assistant_id": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "metadata": {"type": "object"},
    "kwargs": {"type": "object"},
    "multitask_strategy": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "total_input_tokens": {"type": "integer", "minimum": 0},
    "total_output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "llm_call_count": {"type": "integer", "minimum": 0},
    "lead_agent_tokens": {"type": "integer", "minimum": 0},
    "subagent_tokens": {"type": "integer", "minimum": 0},
    "middleware_tokens": {"type": "integer", "minimum": 0},
    "message_count": {"type": "integer", "minimum": 0},
    "stop_reason": {"type": ["string", "null"]}
  }
}
