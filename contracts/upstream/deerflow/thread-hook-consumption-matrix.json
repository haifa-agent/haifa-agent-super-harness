      "transport": "sse",
      "wire_fields": ["updates[].title", "updates[].artifacts", "updates[].todos", "updates[].goal", "SummarizationMiddleware.before_model.messages", "DeerFlowSummarizationMiddleware.before_model.messages"],
      "surface_ids": ["run.create.sdk-sse", "run.join.sdk-sse"],
      "operation_ids": [],
      "auth": "Stream credentials belong to the parent run stream.",
      "evidence_kind": "frozen_hook_source",
      "runtime_status": "NOT_RUN",
      "source_anchors": [
        "onUpdateEvent(data, { mutate }) {",
        "hasRenderedThreadStateUpdate(data)",
        "getSummarizationMiddlewareMessages(data)"
      ]
    },
    {
      "id": "hooks.useThreadStream.onCustomEvent.task-events",
      "hook": "useThreadStream",
      "trigger": "onCustomEvent(event)",
      "condition": "A custom stream frame; handled types are stream_replay_gap, task_started/task_running and llm_retry.",
      "consumer": "langgraph_sdk",
      "sdk_call": "useStream onCustomEvent",
      "transport": "sse",
      "wire_fields": ["custom.type=stream_replay_gap", "custom.type=task_started", "custom.type=task_running", "task_running.message_index", "custom.type=llm_retry", "llm_retry.message"],
      "surface_ids": ["run.create.sdk-sse", "run.join.sdk-sse"],
      "operation_ids": [],
      "auth": "Stream credentials belong to the parent run stream.",
      "evidence_kind": "frozen_hook_source",
      "runtime_status": "NOT_RUN",
      "source_anchors": [
        "onCustomEvent(event: unknown) {",
        "eventType === \"stream_replay_gap\"",
        "eventType === \"task_running\"",
        "eventType === \"llm_retry\""
      ]
    },
    {
      "id": "hooks.useThreadStream.onError.retry-and-invalidate",
      "hook": "useThreadStream",
      "trigger": "onError(error)",
      "condition": "The SDK stream raises (network, HTTP, or SSE error).",
      "consumer": "langgraph_sdk",
      "sdk_call": "useStream onError",
      "transport": "sse",
      "wire_fields": ["error.status", "error.response.status", "error.message", "error.error.message"],
      "surface_ids": ["run.create.sdk-sse", "thread.messages-page.browser"],
