    {
      "id": "hooks.useThreadStream.client.config",
      "hook": "useThreadStream",
      "trigger": "useStream(...) mount",
      "condition": "Always runs; isMock selects the static/mock client. assistantId defaults to lead_agent or a custom agent name; reconnectOnMount, fetchStateHistory and throttle are fixed options.",
      "consumer": "langgraph_sdk",
      "sdk_call": "new LangGraphClient + useStream",
      "transport": "rest",
      "wire_fields": ["client.apiUrl (/api/langgraph default)", "assistantId", "threadId", "reconnectOnMount=true", "fetchStateHistory.limit=1", "throttle=true"],
      "surface_ids": ["thread.state.sdk-rest", "thread.history.sdk-rest"],
      "operation_ids": [],
      "auth": "SDK onRequest injects X-CSRF-Token from csrf_token cookie for state-changing calls; cookie credentials included.",
      "evidence_kind": "frozen_hook_source",
      "runtime_status": "NOT_RUN",
      "source_anchors": [
        "const thread = useStream<AgentThreadState>({",
        "client: getAPIClient(isMock),",
        "assistantId,",
        "threadId: onStreamThreadId,",
        "reconnectOnMount: true,",
        "fetchStateHistory: { limit: 1 },",
        "throttle: true,"
      ]
    },
    {
      "id": "hooks.useThreadStream.onCreated.agent-metadata",
