{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["thread_id", "body"],
  "properties": {
    "thread_id": {"type": "string", "minLength": 1},
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "before": {"type": ["string", "null"]}
      }
    }
  }
}
