    {
      "id": "hooks.useThreadStream.active-run-rejoin",
      "hook": "useThreadStream",
      "trigger": "reconnect effect after runs.list resolves",
      "condition": "An active run (status pending|running) is not completed, is not already owned by the tab-local reconnect pointer, is under the bounded retry budget, and the thread is not loading.",
      "consumer": "langgraph_sdk",
      "sdk_call": "thread.joinStream",
      "transport": "sse",
      "wire_fields": ["runs.list[].status", "runs.list[].run_id", "sessionStorage key lg:stream:<threadId>"],
      "surface_ids": ["run.join.sdk-sse", "thread.runs.sdk-rest", "run.get.sdk-rest"],
      "operation_ids": [],
      "auth": "Read/owner permission enforced by the Gateway join route; apply_on_disconnect=false for observer joins.",
      "evidence_kind": "frozen_hook_source",
      "runtime_status": "NOT_RUN",
      "source_anchors": [
        "void joinStream(resolvedRunId);",
        "ACTIVE_RUN_REJOIN_RETRY_DELAYS_MS = [1_000, 2_000] as const;",
        "MAX_ACTIVE_RUN_REJOIN_ATTEMPTS =",
        "readReconnectRun(resolvedThreadId) === resolvedRunId",
        "ACTIVE_RUN_STATUSES = new Set([\"pending\", \"running\"]);"
      ]
    },
