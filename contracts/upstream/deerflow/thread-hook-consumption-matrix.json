      "operation_ids": [],
      "auth": "SDK onRequest CSRF for PATCH; response errors are swallowed by .catch(() => ({}))",
      "evidence_kind": "frozen_hook_source",
      "runtime_status": "NOT_RUN",
      "source_anchors": [
        "if (context.agent_name && !isMock) {",
        ".threads.update(meta.thread_id, {",
        "metadata: { agent_name: context.agent_name },"
      ]
    },
    {
      "id": "hooks.useThreadStream.onUpdateEvent.thread-state",
      "hook": "useThreadStream",
      "trigger": "onUpdateEvent(data, { mutate })",
