      "runtime_status": "NOT_RUN",
      "evidence": [
        {"source_path": "frontend/src/core/auth/setup.ts", "must_contain": ["fetch(\"/api/v1/auth/setup-status\"", "cache: \"no-store\""]},
        {"source_path": "backend/app/gateway/routers/auth.py", "must_contain": ["@router.get(\"/setup-status\")"]},
        {"source_path": "backend/app/gateway/app.py", "must_contain": ["app.include_router(auth.router)"]}
      ]
    },
    {
      "id": "auth.me.browser",
      "category": "auth",
      "consumer": "browser_fetch",
      "transport": "REST",
      "methods": ["GET"],
      "public_path": "/api/v1/auth/me",
      "gateway_path": "/api/v1/auth/me",
      "registration_condition": "Always registered. Auth-disabled mode still returns a server-selected default user and effective permissions; it does not trust a client owner.",
