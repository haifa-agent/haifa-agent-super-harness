# Maven Wrapper: keep the POSIX launcher as LF so ./mvnw stays executable from
# Git Bash/WSL even when core.autocrlf=true, and pin the Windows launcher to CRLF.
mvnw text eol=lf
mvnw.cmd text eol=crlf
.mvn/wrapper/maven-wrapper.properties text eol=lf
# Frozen Skill package hashes refer to exact upstream bytes on every checkout.
third-party/deerflow/skills/**/SKILL.md -text
# The trusted Skill manifest hashes the pinned DeerFlow license's LF bytes.
third-party/deerflow/LICENSES/deer-flow-MIT.txt text eol=lf
